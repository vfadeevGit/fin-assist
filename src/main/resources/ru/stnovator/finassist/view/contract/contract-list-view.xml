<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://ru.stnovator.finassist.view.contract/contractListView.title"
      focusComponent="contractsDataGrid">
    <data>
        <collection id="contractsDc"
                    class="ru.stnovator.finassist.entity.Contract">
            <fetchPlan extends="_base"/>
            <loader id="contractsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Contract e order by e.startDate desc, e.internalID, e.id]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="aiToolsAction" type="finassist_openAiTools"
                text="msg://ru.stnovator.finassist.ai/openAiTools.text"
                description="msg://ru.stnovator.finassist.ai/openAiTools.description"/>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <dataGridFilter component="contractsDataGrid"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="contractsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" action="contractsDataGrid.create"/>
            <button id="editBtn" action="contractsDataGrid.edit"/>
            <button id="removeBtn" action="contractsDataGrid.remove"/>
            <button id="runReportBtn" action="contractsDataGrid.runReportAction"/>
            <button id="aiToolsBtn" action="aiToolsAction"/>
            <button id="clearColumnFiltersBtn" text="msg://ru.stnovator.finassist/columnFilters.clearAll">
                <tooltip text="msg://ru.stnovator.finassist/columnFilters.clearAll.description"/>
            </button>
            <simplePagination id="pagination" dataLoader="contractsDl"/>
        </hbox>
        <dataGrid id="contractsDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="contractsDc">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="remove" type="list_remove"/>
                <action id="runReportAction" type="report_runReport"/>
            </actions>
            <columns resizable="true">
                <column key="relatedDetails" frozen="true" sortable="false" flexGrow="0" width="3em"/>
                <column property="internalID" filterable="true"/>
                <column property="startDate" filterable="true"/>
                <column property="endDate" filterable="true"/>
                <column property="customer" filterable="true"/>
                <column property="paymentType" filterable="true"/>
                <column property="totalAmount" filterable="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
