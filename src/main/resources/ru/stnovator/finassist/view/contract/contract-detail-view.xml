<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://ru.stnovator.finassist.view.contract/contractDetailView.title" focusComponent="form">
    <data>
        <instance id="contractDc" class="ru.stnovator.finassist.entity.Contract">
            <fetchPlan extends="_base">
                <property name="projects" fetchPlan="_base">
                    <property name="lineOfBusiness" fetchPlan="_base" />
                </property>
                <property name="addenda" fetchPlan="_base" />
            </fetchPlan>
            <loader />
            <collection id="projectsDc" property="projects" />
            <collection id="addendaDc" property="addenda" />
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose" />
        <action id="closeAction" type="detail_close" />
    </actions>
    <facets>
        <dataLoadCoordinator auto="true" />
    </facets>
    <layout classNames="detail-editor" padding="false" spacing="false" height="100%">
        <scroller id="detailScroller" width="100%" scrollBarsDirection="VERTICAL" classNames="detail-scroller">
            <vbox id="detailContent" width="100%" padding="false" spacing="false" classNames="detail-content">
                <formLayout id="form" dataContainer="contractDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1" />
                        <responsiveStep minWidth="40em" columns="2" />
                    </responsiveSteps>
                    <entityPicker property="customer" classNames="detail-reference-field">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup" />
                            <action id="entityClearAction" type="entity_clear" />
                            <action id="openAction" type="entity_open" />
                        </actions>
                    </entityPicker>
                    <textField id="internalIDField" property="internalID" />
                    <datePicker id="startDateField" property="startDate" />
                    <datePicker id="endDateField" property="endDate" />
                    <comboBox id="paymentTypeField" property="paymentType" />
                    <bigDecimalField id="paymentDaysField" property="paymentDays" />
                    <textField id="totalAmountField" property="totalAmount" />
                </formLayout>
                <tabSheet id="contractTabs" width="100%">
                    <tab id="projectsTab" label="msg://contractDetailView.projectsTab">
                        <vbox id="projectsTabBox" width="100%" padding="false" spacing="false" classNames="detail-collection">
                            <hbox id="projectsButtonsPanel" classNames="detail-toolbar" width="100%">
                                <button id="createProjectBtn" action="projectsDataGrid.create" />
                                <button id="editProjectBtn" action="projectsDataGrid.edit" />
                                <button id="removeProjectBtn" action="projectsDataGrid.remove" />
                            </hbox>
                            <dataGrid id="projectsDataGrid" dataContainer="projectsDc" width="100%" classNames="detail-grid" emptyStateText="msg://ru.stnovator.finassist.view.detail/emptyItems">
                                <actions>
                                    <action id="create" type="list_create">
                                        <properties>
                                            <property name="openMode" value="DIALOG" />
                                            <property name="viewId" value="Project.detail" />
                                        </properties>
                                    </action>
                                    <action id="edit" type="list_edit">
                                        <properties>
                                            <property name="openMode" value="DIALOG" />
                                            <property name="viewId" value="Project.detail" />
                                        </properties>
                                    </action>
                                    <action id="remove" type="list_remove" />
                                </actions>
                                <columns>
                                    <column property="name" resizable="true" width="18em" />
                                    <column property="lineOfBusiness" resizable="true" width="18em" />
                                </columns>
                            </dataGrid>
                        </vbox>
                    </tab>
                    <tab id="addendaTab" label="msg://contractDetailView.addendaTab">
                        <vbox id="addendaTabBox" width="100%" padding="false" spacing="false" classNames="detail-collection">
                            <hbox id="addendaButtonsPanel" classNames="detail-toolbar" width="100%">
                                <button id="createAddendumBtn" text="msg:///actions.Create" />
                                <button id="editAddendumBtn" text="msg:///actions.Edit" />
                                <button id="removeAddendumBtn" action="addendaDataGrid.remove" />
                            </hbox>
                            <dataGrid id="addendaDataGrid" dataContainer="addendaDc" width="100%" classNames="detail-grid" emptyStateText="msg://ru.stnovator.finassist.view.detail/emptyItems">
                                <actions>
                                    <action id="remove" type="list_remove" />
                                </actions>
                                <columns>
                                    <column property="number" resizable="true" width="10em" />
                                    <column property="effectiveDate" resizable="true" width="10em" />
                                </columns>
                            </dataGrid>
                        </vbox>
                    </tab>
                </tabSheet>
            </vbox>
        </scroller>
        <hbox id="detailActions" classNames="detail-actions" width="100%">
            <button id="saveAndCloseBtn" action="saveAction" text="msg://ru.stnovator.finassist.view.detail/saveClose" />
            <button id="closeBtn" action="closeAction" />
        </hbox>
    </layout>
</view>