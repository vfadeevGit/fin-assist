<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://ru.stnovator.finassist.view.shipmentschedule/ShipmentScheduleDetailView.title" focusComponent="form">
    <data>
        <instance id="shipmentScheduleDc" class="ru.stnovator.finassist.entity.ShipmentSchedule">
            <fetchPlan extends="_base">
                <property fetchPlan="_base" name="project">
                    <property fetchPlan="_base" name="contract">
                        <property fetchPlan="_base" name="customer" />
                    </property>
                </property>
                <property fetchPlan="_base" name="items">
                    <property name="schedule" fetchPlan="_base" />
                </property>
            </fetchPlan>
            <loader />
            <collection id="shipmentScheduleItemsDc" property="items" />
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose" />
        <action id="closeAction" type="detail_close" />
    </actions>
    <facets>
        <dataLoadCoordinator auto="true" />
    </facets>
    <layout classNames="detail-editor" padding="false" spacing="false" height="100%">
        <scroller id="detailScroller" width="100%" scrollBarsDirection="VERTICAL" classNames="detail-scroller">
            <vbox id="detailContent" width="100%" padding="false" spacing="false" classNames="detail-content">
                <formLayout id="form" dataContainer="shipmentScheduleDc">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1" />
                        <responsiveStep minWidth="40em" columns="2" />
                    </responsiveSteps>
                    <entityPicker id="projectField" property="project" label="msg://ru.stnovator.finassist.view.shipmentschedule/ShipmentScheduleDetailView.project" classNames="detail-reference-field">
                        <actions>
                            <action id="openAction" type="entity_open" />
                            <action id="lookupAction" type="entity_lookup" />
                            <action id="clearAction" type="value_clear" />
                        </actions>
                    </entityPicker>
                    <entityPicker id="contractField" property="project.contract" label="msg://ru.stnovator.finassist.view.shipmentschedule/ShipmentScheduleDetailView.contract" readOnly="true" required="false" classNames="detail-context-field" />
                    <entityPicker id="customerField" property="project.contract.customer" label="msg://ru.stnovator.finassist.view.shipmentschedule/ShipmentScheduleDetailView.customer" readOnly="true" required="false" classNames="detail-context-field" />
                </formLayout>
                <details id="recordMetadata" summaryText="msg://ru.stnovator.finassist.view.detail/recordMetadata" width="100%" classNames="detail-metadata">
                    <vbox padding="false" spacing="false" width="100%">
                        <textField id="createdDateField" dataContainer="shipmentScheduleDc" property="createdDate" readOnly="true" required="false" width="100%" classNames="detail-metadata-field" label="msg://ru.stnovator.finassist.view.detail/createdDate" />
                        <textField id="lastModifiedDateField" dataContainer="shipmentScheduleDc" property="lastModifiedDate" readOnly="true" required="false" width="100%" classNames="detail-metadata-field" label="msg://ru.stnovator.finassist.view.detail/lastModifiedDate" placeholder="msg://ru.stnovator.finassist.view.detail/notModified" />
                    </vbox>
                </details>
                <h4 text="msg://ru.stnovator.finassist.view.shipmentschedule/ShipmentScheduleDetailView.items" />
                <hbox id="itemsButtonsPanel" classNames="detail-toolbar" width="100%">
                    <button id="createItemBtn" action="shipmentScheduleItemsDataGrid.create" />
                    <button id="editItemBtn" action="shipmentScheduleItemsDataGrid.edit" />
                    <button id="removeItemBtn" action="shipmentScheduleItemsDataGrid.remove" />
                </hbox>
                <dataGrid id="shipmentScheduleItemsDataGrid" dataContainer="shipmentScheduleItemsDc" width="100%" classNames="detail-grid" emptyStateText="msg://ru.stnovator.finassist.view.detail/emptyItems">
                    <actions>
                        <action id="create" type="list_create">
                            <properties>
                                <property name="openMode" value="DIALOG" />
                                <property name="viewId" value="ShipmentScheduleItem.detail" />
                            </properties>
                        </action>
                        <action id="edit" type="list_edit">
                            <properties>
                                <property name="openMode" value="DIALOG" />
                                <property name="viewId" value="ShipmentScheduleItem.detail" />
                            </properties>
                        </action>
                        <action id="remove" type="list_remove" />
                    </actions>
                    <columns>
                        <column property="itemDate" header="msg://columnPlannedDate.header" resizable="true" width="10em" />
                        <column property="amount" header="msg://columnPlannedAmount.header" resizable="true" width="12em" textAlign="END" />
                    </columns>
                </dataGrid>
            </vbox>
        </scroller>
        <hbox id="detailActions" classNames="detail-actions" width="100%">
            <button id="saveAndCloseBtn" action="saveAction" text="msg://ru.stnovator.finassist.view.detail/saveClose" />
            <button id="closeBtn" action="closeAction" />
        </hbox>
    </layout>
</view>