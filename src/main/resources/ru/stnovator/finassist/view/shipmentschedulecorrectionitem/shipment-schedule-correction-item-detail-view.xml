<?xml version='1.0' encoding='UTF-8'?>
<view xmlns="http://jmix.io/schema/flowui/view" title="msg://ru.stnovator.finassist.view.shipmentschedulecorrectionitem/ShipmentScheduleCorrectionItemDetailView.title" focusComponent="form">
    <data>
        <instance id="shipmentScheduleCorrectionItemDc" class="ru.stnovator.finassist.entity.ShipmentScheduleCorrectionItem">
            <fetchPlan extends="_base" />
            <loader />
        </instance>
    </data>
    <actions>
        <action id="saveAction" type="detail_saveClose" />
        <action id="closeAction" type="detail_close" />
    </actions>
    <facets>
        <dataLoadCoordinator auto="true" />
    </facets>
    <layout classNames="detail-editor" padding="false" spacing="false" height="100%">
        <scroller id="detailScroller" width="100%" scrollBarsDirection="VERTICAL" classNames="detail-scroller">
            <vbox id="detailContent" width="100%" padding="false" spacing="false" classNames="detail-content">
                <span id="parentContextHint" text="msg://ru.stnovator.finassist.view.detail/parentRequired" visible="false" classNames="detail-empty-state" />
                <formLayout id="form" dataContainer="shipmentScheduleCorrectionItemDc" classNames="detail-form-single">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1" />
                    </responsiveSteps>
                    <entityPicker id="correctionField" property="correction" readOnly="true" required="false" classNames="detail-context-field" />
                    <datePicker id="itemDateField" property="itemDate" />
                    <textField id="amountField" property="amount" />
                </formLayout>
            </vbox>
        </scroller>
        <hbox id="detailActions" classNames="detail-actions" width="100%">
            <button id="saveAndCloseBtn" action="saveAction" text="msg://ru.stnovator.finassist.view.detail/saveClose" />
            <button id="closeBtn" action="closeAction" />
        </hbox>
    </layout>
</view>