<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<mainView xmlns="http://jmix.io/schema/flowui/main-view"
          title="msg://MainView.title">
    <actions>
        <action id="logout" type="logout"/>
        <action id="askAssistantAction" type="finassist_openAiTools"
                text="msg://ru.stnovator.finassist.ai/openAiTools.text"
                description="msg://ru.stnovator.finassist.ai/openAiTools.description"/>
    </actions>
    <appLayout>
        <navigationBar>
            <header id="header" classNames="jmix-main-view-header">
                <drawerToggle id="drawerToggle"
                              classNames="jmix-main-view-drawer-toggle"
                              themeNames="contrast"
                              ariaLabel="msg://drawerToggle.ariaLabel"/>
                <h1 id="viewTitle" classNames="jmix-main-view-title"/>
            </header>
        </navigationBar>
        <drawerLayout>
            <section id="section" classNames="jmix-main-view-section">
                <h2 id="applicationTitle"
                    classNames="jmix-main-view-application-title">
                    <anchor id="baseLink"
                            href="."
                            text="msg://applicationTitle.text"
                            classNames="jmix-main-view-application-title-base-link"/>
                </h2>
                <nav id="navigation"
                     classNames="jmix-main-view-navigation"
                     ariaLabel="msg://navigation.ariaLabel">
                    <listMenu id="menu"/>
                </nav>
                <footer id="footer" classNames="jmix-main-view-footer">
                    <userIndicator id="userIndicator"/>
                    <button id="logoutButton"
                            action="logout"
                            classNames="jmix-logout-button"/>
                </footer>
            </section>
        </drawerLayout>
        <initialLayout>
            <div id="dashboard" classNames="main-dashboard">
                <div classNames="dashboard-heading">
                    <h2 text="msg://dashboard.heading"/>
                    <button id="dashboardRefreshButton" text="msg://dashboard.refresh"/>
                </div>
                <span id="dashboardEmptyMessage" text="msg://dashboard.empty" visible="false"/>
                <div classNames="dashboard-grid dashboard-indicators">
                    <div id="customersIndicator" classNames="dashboard-indicator">
                        <span text="msg://dashboard.customers.total" classNames="dashboard-count-label"/>
                        <span id="customersCount" classNames="dashboard-count"/>
                    </div>
                    <div id="contractsIndicator" classNames="dashboard-indicator">
                        <span text="msg://dashboard.contracts.total" classNames="dashboard-count-label"/>
                        <span id="contractsCount" classNames="dashboard-count"/>
                    </div>
                    <div id="projectsIndicator" classNames="dashboard-indicator">
                        <span text="msg://dashboard.projects.total" classNames="dashboard-count-label"/>
                        <span id="projectsCount" classNames="dashboard-count"/>
                    </div>
                </div>
                <div classNames="dashboard-grid dashboard-tiles">
                    <button id="customersTile" classNames="dashboard-tile"/>
                    <button id="contractsTile" classNames="dashboard-tile"/>
                    <button id="projectsTile" classNames="dashboard-tile"/>
                </div>
                <div id="assistantCard" classNames="dashboard-assistant-card" visible="false">
                    <div id="assistantIcon" classNames="dashboard-assistant-icon"/>
                    <div classNames="dashboard-assistant-copy">
                        <h3 text="msg://dashboard.assistant.name"/>
                        <span text="msg://dashboard.assistant.role" classNames="dashboard-assistant-role"/>
                        <p text="msg://dashboard.assistant.description"/>
                    </div>
                    <button id="askAssistantButton" action="askAssistantAction"
                            themeNames="primary" classNames="dashboard-assistant-button"/>
                </div>
            </div>
        </initialLayout>
    </appLayout>
</mainView>
