DOMAIN=fin-assist.st-novator.ru
# Required for FIRST certificate issuance: use your real certificate contact.
# Existing installations retain the registered account and certificate volumes.
LETSENCRYPT_EMAIL=

APP_IMAGE=vfadeevdocker/fin-assist
# Set these to the tag and digest from a successful GitHub image build.
# On an existing VPS, preserve the deployed values; CI updates them after deployment.
APP_TAG=
APP_DIGEST=

# Initial-install defaults only. Preserve the actual credentials on an existing VPS.
POSTGRES_DB=finassist_db
POSTGRES_USER=finassist
POSTGRES_PASSWORD=

# OpenWebUI API key: configure on the VPS, never in the image or Git repository.
OPENAI_BASE_URL=https://ai2mee.ru/api
OPENAI_API_KEY=
# Required: exact model ID returned by GET /api/models for this API key.
OPENAI_MODEL=

JAVA_TOOL_OPTIONS="-Xmx1024m -XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -XX:MinHeapFreeRatio=20 -XX:MaxHeapFreeRatio=40"
